# Kopiere diese Datei nach .env und fülle die Werte aus.

# Öffentliche Adresse des Shops (ohne Schrägstrich am Ende)
BASE_URL=https://ravenyz.com

# Stripe: Dashboard -> Entwickler -> API-Schlüssel (zuerst Test-Schlüssel sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe: Dashboard -> Entwickler -> Webhooks -> Signatur-Geheimnis (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP-Zugang des Postfachs, über das die Bestell-Mails verschickt werden
SMTP_HOST=mail.example.ch
SMTP_PORT=465
SMTP_USER=info@hoferaytee.ch
SMTP_PASS=dein-passwort
MAIL_FROM="Ravenyz Shop <info@hoferaytee.ch>"

# Empfänger der Bestell-Benachrichtigung
ORDER_NOTIFY_TO=info@hoferaytee.ch

# Port der API (nur lokal, nginx leitet /api/ hierher weiter)
PORT=3001
